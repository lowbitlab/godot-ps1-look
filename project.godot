; Engine configuration file.
; This project is the demo and test bench of the Lowbit PS1 Look add-on.
; Only the addons/ folder is needed in your own game.

config_version=5

[application]

config/name="Lowbit PS1 Look Demo"
run/main_scene="res://demo/demo.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://addons/lowbit_ps1_look/icon.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[editor_plugins]

enabled=PackedStringArray("res://addons/lowbit_ps1_look/plugin.cfg")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
